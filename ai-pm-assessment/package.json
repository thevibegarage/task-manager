{
  "name": "ai-pm-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone AI Product Management / RAG assessment with server-side scoring and an instructor dashboard.",
  "scripts": {
    "predev": "node scripts/setup-local.mjs",
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "vercel-build": "node scripts/prisma-generate.mjs && node scripts/db-deploy.mjs && next build",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
