# Database connection string.
#   Local (SQLite):            DATABASE_URL="file:./dev.db"   (path is relative to prisma/)
#   Production (PostgreSQL):   DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL=

# Optional, PostgreSQL only: direct (non-pooled) connection used for schema changes,
# e.g. Supabase's direct / session-pooler URL when DATABASE_URL is the transaction pooler.
# DIRECT_URL=

# Instructor login for /admin.
ADMIN_EMAIL=
# Plaintext, or a scrypt hash from `npm run hash-password -- '<password>'` (recommended in production).
ADMIN_PASSWORD=

# Random string of at least 32 characters used to sign the instructor session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
